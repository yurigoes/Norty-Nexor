# =========================================================
#  my Home by norty — proxy de borda
# ---------------------------------------------------------
#  O Caddy resolve HTTPS sozinho: emite o certificado no primeiro
#  acesso e renova antes de vencer. Não há passo manual de SSL.
# =========================================================

{
	email {$ACME_EMAIL}
	# Não anunciar a versão do servidor para quem estiver sondando.
	servers {
		metrics
	}
}

(seguranca) {
	header {
		# HSTS: depois da primeira visita, o navegador se recusa a
		# acessar por HTTP mesmo que alguém force o link.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

{$APP_DOMAIN} {
	import seguranca
	encode zstd gzip

	reverse_proxy web:80

	log {
		output file /data/access-web.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

{$API_DOMAIN} {
	import seguranca
	encode zstd gzip

	reverse_proxy api:3333 {
		header_up X-Real-IP {remote_host}
		health_uri /v1/health
		health_interval 30s
	}

	log {
		output file /data/access-api.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# =========================================================
#  LICITA+ — inteligência para oportunidades públicas
#  Produto independente do my Home; compartilha só a borda.
# =========================================================
{$LICITA_DOMAIN} {
	import seguranca
	encode zstd gzip

	reverse_proxy licita:80

	log {
		output file /data/access-licita.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
