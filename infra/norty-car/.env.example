# =========================================================
#  Norty Car — variáveis de produção
#  Copie para infra/norty-car/.env. NUNCA versione o .env.
# =========================================================

# ---- Endereços ----
APP_URL=https://car.norty.com.br
API_URL=https://api-car.norty.com.br
APP_HOSTS=car.norty.com.br
COOKIE_DOMAIN=.norty.com.br
# Sites das locadoras: <slug>.SITE_BASE_DOMAIN
SITE_BASE_DOMAIN=car.norty.com.br
# Destino do CNAME que a locadora cria no domínio próprio.
SITE_CNAME_TARGET=sites.car.norty.com.br

# ---- Portas internas (destino das rotas do túnel) ----
WEB_PORT=3070
API_PORT=3071

# ---- Banco (CT 102 Yggdrasil) ----
# O usuário NÃO pode ser superusuário nem ter BYPASSRLS: o isolamento
# entre empresas depende do Row-Level Security valer para ele.
POSTGRES_HOST=192.168.15.72
POSTGRES_PORT=5432
POSTGRES_DB=nortycar
POSTGRES_USER=nortycar
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Segredos ----
# openssl rand -hex 32  (trocar derruba todas as sessões)
JWT_SECRET=
# openssl rand -hex 32  (cifra MFA e segredos de integração; trocar
# sem migrar torna esses segredos ilegíveis — guarde no cofre)
SECRETS_KEY=

# ---- Primeiro acesso ao Master (usado só pelo seed) ----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# mínimo 12 caracteres; troca obrigatória no primeiro login
BOOTSTRAP_ADMIN_PASSWORD=

# ---- E-mail (opcional; sem ele, links de acesso são entregues em mãos) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Norty IA (opcional; sem a chave, a IA aparece como não configurada) ----
ANTHROPIC_API_KEY=

# ---- Borda para domínios próprios (perfil custom-domains) ----
ACME_EMAIL=

APP_VERSION=1.0.0

# Modo apresentação: e-mails que podem trocar o próprio perfil pelo menu do usuário.
# Deixe vazio em produção real.
DEMO_ROLE_SWITCH_EMAILS=
