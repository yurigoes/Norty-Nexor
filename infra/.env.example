# =========================================================
#  my Home by norty — CT 105 Asgard (fase3)
#  Copie para infra/.env no host thor, em
#  /srv/apps-fase3/my-home/infra/.env
# =========================================================

# ---- Domínios públicos (servidos pelo Cloudflare Tunnel) ----
APP_URL=https://myhome.norty.com.br
API_URL=https://api-myhome.norty.com.br
COOKIE_DOMAIN=.norty.com.br

# ---- Portas internas do CT 105 (192.168.15.75) ----
# São o destino das rotas do túnel. Confira que estão livres:
#   pct exec 105 -- ss -lntp | grep -E '3060|3061'
WEB_PORT=3060
API_PORT=3061

# ---- Infra compartilhada — CT 102 Yggdrasil ----
POSTGRES_HOST=192.168.15.72
POSTGRES_PORT=5432
POSTGRES_DB=myhome
POSTGRES_USER=myhome
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

REDIS_HOST=192.168.15.72
REDIS_PORT=6379
# Um índice só para o my Home, para não colidir com os outros apps.
REDIS_DB=7

# ---- Sessão ----
# Gere com: openssl rand -base64 48
# Trocar este valor derruba todas as sessões ativas.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

APP_VERSION=1.0.0
