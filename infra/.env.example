# =========================================================
#  my Home by norty — variáveis de produção
#  Copie para infra/.env e preencha antes do primeiro deploy.
# =========================================================

# ---- Domínios ----
APP_DOMAIN=myhome.norty.com.br
API_DOMAIN=api-myhome.norty.com.br
APP_URL=https://myhome.norty.com.br
API_URL=https://api-myhome.norty.com.br

# ---- LICITA+ ----
# Domínio do LICITA+. O Caddy emite o certificado no primeiro
# acesso, então basta o DNS apontar para o Thor antes de subir.
#
# Vazio não quebra a stack: sem valor, o Caddy usa
# `licita.localhost` com certificado interno e o LICITA+ fica
# acessível só de dentro do servidor. Preencha para publicar.
LICITA_DOMAIN=

# E-mail usado pelo Let's Encrypt para avisar sobre renovação.
ACME_EMAIL=voce@norty.com.br

# ---- Banco ----
POSTGRES_USER=myhome
POSTGRES_DB=myhome
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Sessão ----
# Gere com: openssl rand -base64 48
# Trocar este valor derruba todas as sessões ativas.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# O ponto na frente faz o cookie valer para myhome e api-myhome.
COOKIE_DOMAIN=.norty.com.br

APP_VERSION=1.0.0
