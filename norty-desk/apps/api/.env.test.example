# Copie para .env.test. A suíte TRUNCA todas as tabelas deste banco:
# aponte para um banco só dela, nunca para o de desenvolvimento.
#
#   createdb nortydesk_test
#   DATABASE_URL=... npx prisma migrate deploy

# Banco só da suíte: ela trunca tudo entre execuções, e apontar para o
# banco de desenvolvimento apagaria o trabalho de quem está testando à mão.
DATABASE_URL="postgresql://desk@127.0.0.1:5432/nortydesk_test?schema=public"
NODE_ENV=test
JWT_SECRET=TROQUE-em-cada-maquina-0123456789abcdef01
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CHANNEL_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ARMAZENAMENTO=disco
ARMAZENAMENTO_DIR=/tmp/norty-desk-anexos-teste
ENVIO=simulado
