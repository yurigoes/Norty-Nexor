// Norty Desk — schema do domínio.
//
// Regras que o banco garante (CLAUDE.md, regra 4):
//   - número de chamado único por organização
//   - um e-mail recebido só vira evento uma vez (messageId único)
//   - uma mensagem de WhatsApp só vira evento uma vez
//   - um voto de aprovação por validador por etapa
//   - um ator não se repete no mesmo papel do mesmo chamado
//
// Tempo de SLA é Int em segundos. Dinheiro é Decimal(12,2). Nunca Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Organização e pessoas
// ---------------------------------------------------------------------

/// Substitui glpi_entities. Plana, sem herança recursiva.
/// Ver docs/02-gap-analysis.md, item 7.
model Organization {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  name           String
  isActive       Boolean  @default(true)
  /// Matriz 5x5 urgência x impacto -> prioridade. Null usa o padrão global.
  priorityMatrix Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    Membership[]
  teams          Team[]
  categories     Category[]
  tickets        Ticket[]
  agreements     Agreement[]
  calendars      Calendar[]
  pendingReasons PendingReason[]
  forms          TicketForm[]
  articles       Article[]
  channels       ChannelAccount[]
  suppliers      Supplier[]
  rules          IntakeRule[]
  webhooks       OutboundWebhook[]
  apiKeys        ApiKey[]
  contacts       Contact[]
  assets         Asset[]
  surveys        Survey[]
  problems       Problem[]
  changes        Change[]
  recurrences    RecurringTicket[]
  templates      Template[]
  contracts      Contract[]
  budgets        Budget[]
  locations      Location[]
  manufacturers  Manufacturer[]
  assetModels    AssetModel[]
  components     AssetComponent[]
  authSources    AuthSource[]
  software       Software[]
  softwareLicenses SoftwareLicense[]
  consumables    ConsumableItem[]
  consumableMovements ConsumableMovement[]

  @@map("organizations")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Opcional: conta de diretório pode não ter e-mail (decisão do Yuri,
  /// 10/09/2026). Único quando preenchido.
  email              String?  @unique
  name               String
  /// Argon2id. A API nunca devolve este campo.
  passwordHash       String
  phone              String?
  avatarUrl          String?
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  locale             String   @default("pt-BR")
  /// Diretório que autentica esta pessoa (LDAP). Nulo = conta local, que
  /// entra com a senha guardada aqui.
  authSourceId       String?  @db.Uuid
  /// Identificador estável no diretório — o `sync_field` do GLPI (ex.:
  /// objectGUID). Sobrevive a troca de login no AD.
  externalId         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  authSource     AuthSource?       @relation(fields: [authSourceId], references: [id], onDelete: SetNull)
  memberships    Membership[]
  teamMembers    TeamMember[]
  actorIn        TicketActor[]
  authoredEvents TicketEvent[]     @relation("AutorDoEvento")
  approvals      Approval[]
  refreshTokens  RefreshToken[]
  articles       Article[]
  assets         Asset[]           @relation("AtivoDoUsuario")
  problems       Problem[]         @relation("ResponsavelPeloProblema")
  changes        Change[]          @relation("ResponsavelPelaMudanca")
  recurrences    RecurringTicket[] @relation("RequerenteDaRecorrencia")
  costs          TicketCost[]      @relation("AutorDoCusto")
  articleEdits   ArticleRevision[] @relation("EditorDaRevisao")
  licenses       LicenseAssignment[]
  consumablesReceived ConsumableMovement[] @relation("DestinatarioDoConsumivel")
  consumableMovements ConsumableMovement[] @relation("AutorDoMovimento")

  @@unique([authSourceId, externalId])
  @@map("users")
}

/// Vínculo usuário x organização x perfil. Substitui glpi_profiles_users.
model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           Role
  /// Login por nome de usuário, único dentro da organização (decisão do
  /// Yuri, 10/09/2026): dois clientes podem ter o seu `jsilva`. Minúsculas,
  /// sem "@" — ver common/usuario.ts.
  username       String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@unique([organizationId, username])
  @@index([organizationId])
  @@map("memberships")
}

enum Role {
  SOLICITANTE
  AGENTE
  SUPERVISOR
  GESTOR
  ADMINISTRADOR
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 do token. O valor cru só existe no cookie httpOnly.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Grupo de atendimento. Substitui glpi_groups.
model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  /// E-mail da fila do time, usado como remetente das respostas.
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  actorIn      TicketActor[]
  categories   Category[]
  problems     Problem[]         @relation("TimeDoProblema")
  changes      Change[]          @relation("TimeDaMudanca")
  recurrences  RecurringTicket[] @relation("TimeDaRecorrencia")

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId    String  @db.Uuid
  userId    String  @db.Uuid
  isManager Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

/// Pessoa que fala pelos canais externos e ainda não é usuário do sistema.
/// Resolve o caso do WhatsApp: número conhecido antes do cadastro.
model Contact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String?
  email          String?
  /// E.164, sem espaços. Ex.: +5511999999999
  phone          String?
  /// Preenchido quando o contato é promovido a usuário.
  userId         String?  @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorIn      TicketActor[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@map("contacts")
}

model Supplier {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  email          String?
  phone          String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorIn      TicketActor[]
  contracts    Contract[]
  assets       Asset[]       @relation("FornecedorDoAtivo")
  licenses     SoftwareLicense[] @relation("FornecedorDaLicenca")

  @@unique([organizationId, name])
  @@map("suppliers")
}

// ---------------------------------------------------------------------
// Catálogo de serviço
// ---------------------------------------------------------------------

/// Substitui glpi_itilcategories. Mantém a árvore — aqui ela é útil e
/// rasa (categoria > subcategoria), diferente da árvore de entidades.
model Category {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  parentId       String? @db.Uuid
  name           String
  /// Time que recebe o chamado quando cai nesta categoria.
  defaultTeamId  String? @db.Uuid
  defaultUrgency Int?
  isActive       Boolean @default(true)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent            Category?         @relation("Subcategoria", fields: [parentId], references: [id])
  children          Category[]        @relation("Subcategoria")
  defaultTeam       Team?             @relation(fields: [defaultTeamId], references: [id])
  /// Os acordos aplicados por padrão a um chamado desta categoria.
  ///
  /// É lista, não um só: um chamado precisa de TTO *e* TTR, e quem
  /// vende SLA externo com OLA interno precisa dos quatro. Um `Agreement`
  /// aqui é uma linha de (kind, target) — a "política de atendimento" do
  /// catálogo é o conjunto delas.
  defaultAgreements Agreement[]       @relation("AcordosPadraoDaCategoria")
  tickets           Ticket[]
  forms             TicketForm[]
  articles          Article[]
  problems          Problem[]
  changes           Change[]
  recurrences       RecurringTicket[]
  templates         Template[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@map("categories")
}

/// Substitui as 12 tabelas de tickettemplate*. O esquema do formulário
/// é um JSON declarado. Ver docs/02-gap-analysis.md, item 8.
model TicketForm {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  categoryId     String? @db.Uuid
  name           String
  /// FormSchema em packages/shared/src/domain.ts
  schema         Json
  isDefault      Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@map("ticket_forms")
}

// ---------------------------------------------------------------------
// Chamado
// ---------------------------------------------------------------------

enum TicketType {
  INCIDENTE
  REQUISICAO
}

/// Espelha as constantes de CommonITILObject, com nome em vez de número.
enum TicketStatus {
  NOVO
  ATRIBUIDO
  PLANEJADO
  PENDENTE
  EM_APROVACAO
  SOLUCIONADO
  FECHADO
}

enum Channel {
  WEB
  EMAIL
  WHATSAPP
  API
  SISTEMA
}

model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  /// Sequencial legível por organização. É o que aparece em [#123] no
  /// assunto do e-mail e nas mensagens de WhatsApp.
  number         Int
  subject        String
  /// Descrição inicial. As demais mensagens são eventos.
  description    String
  type           TicketType   @default(INCIDENTE)
  status         TicketStatus @default(NOVO)

  /// 1..5. Prioridade é derivada — só TicketPriorityService escreve nela.
  urgency  Int @default(3)
  impact   Int @default(3)
  priority Int @default(3)

  categoryId    String? @db.Uuid
  formId        String? @db.Uuid
  /// Canal em que o chamado nasceu. Define o canal padrão de resposta.
  originChannel Channel @default(WEB)

  /// Motivo da pendência atual, quando status = PENDENTE.
  pendingReasonId      String?   @db.Uuid
  pendingSince         DateTime?
  /// Quantas cobranças automáticas já saíram nesta pendência.
  pendingRemindersSent Int       @default(0)

  firstResponseAt DateTime?
  solvedAt        DateTime?
  closedAt        DateTime?
  /// Soma do tempo gasto nas tarefas, em segundos.
  spentSeconds    Int       @default(0)

  /// Referência do sistema que abriu o chamado pela API pública.
  ///
  /// Junto com `Idempotency-Key`, é o que impede um monitoramento em
  /// laço abrir mil chamados do mesmo incidente.
  externalRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id])
  form          TicketForm?    @relation(fields: [formId], references: [id])
  pendingReason PendingReason? @relation(fields: [pendingReasonId], references: [id])

  actors       TicketActor[]
  events       TicketEvent[]
  commitments  SlaCommitment[]
  approvals    Approval[]
  attachments  Attachment[]
  /// Respostas do formulário dinâmico, chaveadas pelo campo do schema.
  customFields Json?
  links        TicketLink[]    @relation("ChamadoOrigem")
  linkedBy     TicketLink[]    @relation("ChamadoDestino")
  assets       TicketAsset[]
  survey       Survey?
  costs        TicketCost[]

  /// O problema que causa este chamado e a mudança que o resolve.
  /// São os dois vínculos que o ITIL pede e o GLPI resolve com uma
  /// tabela de ligação polimórfica.
  problemId String?  @db.Uuid
  changeId  String?  @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  change    Change?  @relation(fields: [changeId], references: [id], onDelete: SetNull)

  /// A agenda que abriu este chamado, quando ele não nasceu de gente.
  recurringTicketId String?          @db.Uuid
  recurringTicket   RecurringTicket? @relation(fields: [recurringTicketId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@unique([organizationId, externalRef])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, createdAt])
  @@index([problemId])
  @@index([changeId])
  @@index([recurringTicketId])
  @@map("tickets")
}

enum ActorRole {
  REQUERENTE
  OBSERVADOR
  ATRIBUIDO
}

/// Substitui glpi_tickets_users + glpi_groups_tickets +
/// glpi_suppliers_tickets. Exatamente um dos quatro alvos preenchido.
model TicketActor {
  id         String    @id @default(uuid()) @db.Uuid
  ticketId   String    @db.Uuid
  role       ActorRole
  userId     String?   @db.Uuid
  teamId     String?   @db.Uuid
  supplierId String?   @db.Uuid
  contactId  String?   @db.Uuid
  createdAt  DateTime  @default(now())

  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])
  team     Team?     @relation(fields: [teamId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  contact  Contact?  @relation(fields: [contactId], references: [id])

  @@unique([ticketId, role, userId])
  @@unique([ticketId, role, teamId])
  @@unique([ticketId, role, supplierId])
  @@unique([ticketId, role, contactId])
  @@index([userId])
  @@index([teamId])
  @@map("ticket_actors")
}

enum EventType {
  MENSAGEM
  NOTA_INTERNA
  TAREFA
  SOLUCAO
  APROVACAO
  ANEXO
  MUDANCA_STATUS
  MUDANCA_STATUS_PROBLEMA
  MUDANCA_STATUS_MUDANCA
  MUDANCA_ATRIBUICAO
  MUDANCA_CLASSIFICACAO
  PAUSA_SLA
  RETOMADA_SLA
  ENTRADA_CANAL
  SAIDA_CANAL
}

enum Visibility {
  PUBLICA
  INTERNA
}

/// A timeline única. Substitui glpi_itilfollowups + glpi_tickettasks +
/// glpi_itilsolutions + glpi_documents_items.
/// Ver docs/02-gap-analysis.md, item 4.
/// A linha do tempo de um chamado, de um problema **ou** de uma mudança.
///
/// Três colunas nulas distintas, e um `CHECK` que exige exatamente uma
/// preenchida — nunca `(itemtype, items_id)` em texto como no GLPI. A
/// coluna nomeada dá chave estrangeira, `ON DELETE CASCADE` e índice; o
/// par polimórfico não dá nenhum dos três, e é por isso que o GLPI tem
/// linhas apontando para registros que não existem mais
/// (`docs/03-modelo-de-dados.md`, seção 6).
model TicketEvent {
  id              String     @id @default(uuid()) @db.Uuid
  ticketId        String?    @db.Uuid
  problemId       String?    @db.Uuid
  changeId        String?    @db.Uuid
  type            EventType
  visibility      Visibility @default(PUBLICA)
  /// Nulo quando o autor é o sistema (cron de SLA, regra de entrada).
  authorId        String?    @db.Uuid
  /// Quando o autor é externo e ainda não tem conta.
  authorContactId String?    @db.Uuid
  channel         Channel    @default(WEB)
  /// Corpo em texto. HTML sanitizado quando vem de e-mail.
  body            String?
  /// Campos específicos do tipo. Tipado em shared como EventPayload.
  payload         Json?
  createdAt       DateTime   @default(now())
  editedAt        DateTime?

  ticket         Ticket?         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  problem        Problem?        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  change         Change?         @relation(fields: [changeId], references: [id], onDelete: Cascade)
  author         User?           @relation("AutorDoEvento", fields: [authorId], references: [id])
  attachments    Attachment[]
  /// Rastro do canal: mensagem de e-mail ou WhatsApp que originou o evento.
  inboundMessage InboundMessage?

  @@index([ticketId, createdAt])
  @@index([problemId, createdAt])
  @@index([changeId, createdAt])
  @@map("ticket_events")
}

enum LinkType {
  RELACIONADO
  DUPLICADO_DE
  BLOQUEIA
}

model TicketLink {
  id       String   @id @default(uuid()) @db.Uuid
  sourceId String   @db.Uuid
  targetId String   @db.Uuid
  type     LinkType

  source Ticket @relation("ChamadoOrigem", fields: [sourceId], references: [id], onDelete: Cascade)
  target Ticket @relation("ChamadoDestino", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@map("ticket_links")
}

// ---------------------------------------------------------------------
// Anexos
// ---------------------------------------------------------------------

/// Arquivo no MinIO do CT 102. Substitui glpi_documents +
/// glpi_documents_items + glpi_documenttypes + glpi_documentcategories.
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  /// Mesmo desenho da linha do tempo: três donos possíveis, exatamente
  /// um preenchido, garantido por `CHECK` no banco.
  ticketId     String?  @db.Uuid
  problemId    String?  @db.Uuid
  changeId     String?  @db.Uuid
  eventId      String?  @db.Uuid
  filename     String
  contentType  String
  sizeBytes    Int
  /// Chave no bucket. A URL é assinada na leitura, com validade curta.
  storageKey   String   @unique
  /// SHA-256 do conteúdo, para deduplicação e verificação.
  checksum     String
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  ticket  Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  problem Problem?     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  change  Change?      @relation(fields: [changeId], references: [id], onDelete: Cascade)
  event   TicketEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([problemId])
  @@index([changeId])
  @@map("attachments")
}

// ---------------------------------------------------------------------
// SLA e calendário
// ---------------------------------------------------------------------

enum AgreementKind {
  SLA
  OLA
}

enum TargetKind {
  TTO
  TTR
}

/// Substitui glpi_slas + glpi_olas (ambas descendiam de LevelAgreement).
model Agreement {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  name            String
  kind            AgreementKind
  target          TargetKind
  /// Prazo em segundos de expediente, contado pelo calendário.
  durationSeconds Int
  calendarId      String?       @db.Uuid
  isActive        Boolean       @default(true)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendar     Calendar?         @relation(fields: [calendarId], references: [id])
  levels       EscalationLevel[]
  commitments  SlaCommitment[]
  categories   Category[]        @relation("AcordosPadraoDaCategoria")

  @@unique([organizationId, name, kind, target])
  @@map("agreements")
}

/// Substitui glpi_slalevels + glpi_olalevels + critérios + ações.
model EscalationLevel {
  id            String @id @default(uuid()) @db.Uuid
  agreementId   String @db.Uuid
  name          String
  /// Deslocamento em segundos relativo ao prazo. Negativo dispara antes
  /// do vencimento (-1800 = 30 min antes); positivo, depois.
  offsetSeconds Int
  /// Critérios e ações declarados. Ver EscalationRule em shared.
  criteria      Json?
  actions       Json

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, name])
  @@map("escalation_levels")
}

/// O compromisso de prazo de um chamado. Substitui as 17 colunas de
/// SLA/OLA de glpi_tickets. Ver docs/02-gap-analysis.md, item 5.
model SlaCommitment {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @db.Uuid
  agreementId     String        @db.Uuid
  kind            AgreementKind
  target          TargetKind
  startedAt       DateTime
  /// Vencimento já calculado sobre o calendário.
  dueAt           DateTime
  /// Segundos descontados por pendência.
  pausedSeconds   Int           @default(0)
  achievedAt      DateTime?
  breachedAt      DateTime?
  /// Último nível de escalonamento disparado.
  escalationLevel Int           @default(0)

  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@unique([ticketId, kind, target])
  @@index([dueAt, achievedAt])
  @@map("sla_commitments")
}

/// Calendário de expediente. Substitui glpi_calendars.
model Calendar {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  timezone       String @default("America/Sao_Paulo")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segments     CalendarSegment[]
  holidays     Holiday[]
  agreements   Agreement[]

  @@unique([organizationId, name])
  @@map("calendars")
}

/// Faixa de expediente. Substitui glpi_calendarsegments.
model CalendarSegment {
  id          String @id @default(uuid()) @db.Uuid
  calendarId  String @db.Uuid
  /// 0 = domingo .. 6 = sábado
  weekday     Int
  /// Minutos desde a meia-noite, no fuso do calendário.
  startMinute Int
  endMinute   Int

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, weekday, startMinute])
  @@map("calendar_segments")
}

model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  calendarId  String   @db.Uuid
  name        String
  date        DateTime @db.Date
  /// Feriado que cai no mesmo dia todo ano.
  isRecurring Boolean  @default(false)

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@map("holidays")
}

/// Substitui glpi_pendingreasons. Cobrança automática e resolução por
/// inatividade — um dos melhores recursos do GLPI.
model PendingReason {
  id                        String  @id @default(uuid()) @db.Uuid
  organizationId            String  @db.Uuid
  name                      String
  /// Intervalo entre cobranças, em segundos. 0 desliga a cobrança.
  followupIntervalSeconds   Int     @default(0)
  /// Quantas cobranças antes de resolver sozinho. 0 nunca resolve.
  followupsBeforeResolution Int     @default(0)
  /// Corpo da cobrança automática.
  followupTemplate          String?
  isDefault                 Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@map("pending_reasons")
}

// ---------------------------------------------------------------------
// Aprovação
// ---------------------------------------------------------------------

enum ApprovalStatus {
  AGUARDANDO
  APROVADO
  RECUSADO
}

/// Substitui glpi_ticketvalidations + glpi_validationsteps.
/// Uma linha por validador por etapa.
model Approval {
  id          String         @id @default(uuid()) @db.Uuid
  /// Chamado **ou** mudança: uma mudança normal não executa sem aval, e
  /// é o mesmo motor de etapas e quórum.
  ticketId    String?        @db.Uuid
  changeId    String?        @db.Uuid
  /// Etapas são resolvidas em ordem crescente.
  step        Int            @default(1)
  /// Quantos APROVADO a etapa precisa para avançar.
  quorum      Int            @default(1)
  approverId  String         @db.Uuid
  status      ApprovalStatus @default(AGUARDANDO)
  comment     String?
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?

  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  change   Change? @relation(fields: [changeId], references: [id], onDelete: Cascade)
  approver User    @relation(fields: [approverId], references: [id])

  @@unique([ticketId, step, approverId])
  @@unique([changeId, step, approverId])
  @@index([approverId, status])
  @@map("approvals")
}

// ---------------------------------------------------------------------
// Base de conhecimento
// ---------------------------------------------------------------------

model Article {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  title          String
  body           String
  /// Visível no portal do solicitante, não só para agentes.
  isPublic       Boolean  @default(false)
  /// Aposentado sem perder o histórico: chamado antigo ainda o cita.
  isArchived     Boolean  @default(false)
  /// Assunto do artigo. É o que liga a sugestão à categoria do chamado.
  categoryId     String?  @db.Uuid
  /// Termos que não aparecem no texto e mesmo assim são como a pessoa
  /// procura: código de erro, apelido do sistema, nome do fornecedor.
  /// Entram na busca com o mesmo peso do título.
  keywords       String[] @default([])
  authorId       String   @db.Uuid
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Coluna **gerada** pelo banco a partir de título e corpo, com peso.
  /// A fórmula está na migração `base_de_conhecimento`; aqui ela existe
  /// só para o Prisma saber que a coluna existe. Sem esta linha, todo
  /// `migrate diff` seguinte gera um `DROP COLUMN busca` — o que já
  /// aconteceu uma vez e derrubou a busca de artigos.
  busca Unsupported("tsvector")?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id])
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  revisions    ArticleRevision[]
  problems     Problem[]

  @@index([organizationId, isPublic, isArchived])
  @@index([categoryId])
  /// Etiqueta é busca exata, por sobreposição de array.
  @@index([keywords], type: Gin, map: "articles_keywords")
  @@index([busca], type: Gin, map: "articles_busca")
  @@map("articles")
}

model ArticleRevision {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @db.Uuid
  version   Int
  title     String
  body      String
  /// Por que mudou. Revisão sem motivo é revisão que ninguém consulta.
  note      String?
  editorId  String   @db.Uuid
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation("EditorDaRevisao", fields: [editorId], references: [id])

  @@unique([articleId, version])
  @@map("article_revisions")
}

// ---------------------------------------------------------------------
// Problema
// ---------------------------------------------------------------------

enum ProblemStatus {
  NOVO
  INVESTIGANDO
  CAUSA_IDENTIFICADA
  CONTORNO_PUBLICADO
  RESOLVIDO
  FECHADO
}

/// Substitui glpi_problems.
///
/// Problema é a **causa** de um ou mais chamados, e vive em outro ritmo:
/// o chamado tem prazo de atendimento, o problema tem investigação. Por
/// isso ele é tabela própria e não um `Ticket` com tipo diferente — o
/// SLA de resposta não faz sentido numa investigação de causa raiz.
model Problem {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  /// Sequencial legível por organização, independente do de chamados.
  number         Int
  title          String
  description    String
  status         ProblemStatus @default(NOVO)

  urgency  Int @default(3)
  impact   Int @default(3)
  priority Int @default(3)

  categoryId     String? @db.Uuid
  assignedTeamId String? @db.Uuid
  assignedUserId String? @db.Uuid

  /// O que causa. Preenchido quando a investigação chega ao fim.
  rootCause  String?
  /// O que fazer enquanto a causa não é removida.
  workaround String?

  /// Erro conhecido: causa **e** contorno documentados.
  ///
  /// É o que separa "estamos investigando" de "sabemos o que é e como
  /// contornar" — e é a única coisa que o atendimento precisa saber
  /// quando o mesmo problema gera o décimo chamado.
  isKnownError Boolean   @default(false)
  knownErrorAt DateTime?

  /// Artigo da base que documenta o erro conhecido.
  articleId String? @db.Uuid

  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])
  assignedTeam Team?        @relation("TimeDoProblema", fields: [assignedTeamId], references: [id])
  assignedUser User?        @relation("ResponsavelPeloProblema", fields: [assignedUserId], references: [id])
  article      Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)

  tickets     Ticket[]
  changes     Change[]
  events      TicketEvent[]
  attachments Attachment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, isKnownError])
  @@map("problems")
}

// ---------------------------------------------------------------------
// Mudança
// ---------------------------------------------------------------------

enum ChangeStatus {
  RASCUNHO
  EM_APROVACAO
  APROVADA
  AGENDADA
  EM_EXECUCAO
  CONCLUIDA
  REVERTIDA
  RECUSADA
  CANCELADA
}

enum ChangeKind {
  /// Pré-aprovada: procedimento conhecido e de risco conhecido.
  PADRAO
  NORMAL
  /// Executa antes de aprovar; a aprovação vira registro depois.
  EMERGENCIAL
}

enum ChangeRisk {
  BAIXO
  MEDIO
  ALTO
}

/// Substitui glpi_changes.
model Change {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  number         Int
  title          String
  description    String
  status         ChangeStatus @default(RASCUNHO)
  kind           ChangeKind   @default(NORMAL)
  risk           ChangeRisk   @default(MEDIO)

  categoryId     String? @db.Uuid
  assignedTeamId String? @db.Uuid
  assignedUserId String? @db.Uuid

  implementationPlan String?
  testPlan           String?
  /// Como desfazer. É o que separa mudança de aposta.
  rollbackPlan       String?

  /// Janela de execução acordada.
  windowStart DateTime?
  windowEnd   DateTime?

  startedAt  DateTime?
  finishedAt DateTime?
  /// O que de fato aconteceu, escrito depois da execução.
  outcome    String?

  /// A mudança que remove a causa de um problema.
  problemId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])
  assignedTeam Team?        @relation("TimeDaMudanca", fields: [assignedTeamId], references: [id])
  assignedUser User?        @relation("ResponsavelPelaMudanca", fields: [assignedUserId], references: [id])
  problem      Problem?     @relation(fields: [problemId], references: [id], onDelete: SetNull)

  tickets     Ticket[]
  approvals   Approval[]
  events      TicketEvent[]
  attachments Attachment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, windowStart])
  @@map("changes")
}

// ---------------------------------------------------------------------
// Ativos
// ---------------------------------------------------------------------

enum AssetKind {
  COMPUTADOR
  MONITOR
  IMPRESSORA
  TELEFONE
  REDE
  LICENCA
  OUTRO
}

/// O que se pendura dentro de um equipamento.
///
/// No GLPI cada um destes é duas tabelas — `glpi_deviceprocessors` mais
/// `glpi_items_deviceprocessors` e assim por diante, perto de sessenta
/// ao todo com o mesmo desenho repetido. Aqui é um discriminador.
enum ComponentKind {
  PROCESSADOR
  MEMORIA
  DISCO
  PLACA_MAE
  PLACA_DE_REDE
  PLACA_DE_VIDEO
  PLACA_DE_SOM
  CONTROLADORA
  FONTE
  BATERIA
  UNIDADE_OTICA
  FIRMWARE
  GABINETE
  CAMERA
  SENSOR
  SIMCARD
  OUTRO
}

enum AssetStatus {
  EM_USO
  EM_ESTOQUE
  EM_MANUTENCAO
  BAIXADO
}

/// Equipamento vinculável a chamado.
///
/// **Não é CMDB.** O inventário do GLPI tem 60 tabelas e um agente de
/// coleta; aqui a pergunta é só "qual máquina é essa?" na hora do
/// chamado. O inventário completo é a Fase 6 (`docs/10-roadmap.md`) e
/// vai entrar por importação, não por este modelo.
model Asset {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @db.Uuid
  kind               AssetKind   @default(OUTRO)
  status             AssetStatus @default(EM_USO)
  name               String
  /// Etiqueta de patrimônio. É por ela que o suporte procura.
  tag                String?
  serialNumber       String?
  /// Fabricante, modelo e localização vêm do catálogo.
  ///
  /// Eram texto livre, e texto livre é a origem da sujeira de
  /// inventário: "HP", "hp" e "Hewlett-Packard" são três fabricantes
  /// para quem conta, e um só para quem olha.
  manufacturerId     String?     @db.Uuid
  assetModelId       String?     @db.Uuid
  locationId         String?     @db.Uuid
  /// Quem usa hoje. Nulo quando está em estoque.
  userId             String?     @db.Uuid
  purchasedAt        DateTime?
  warrantyUntil      DateTime?
  notes              String?
  /// Dados financeiros do ativo — o `glpi_infocoms` do GLPI.
  ///
  /// Lá é tabela à parte porque é polimórfica sobre sessenta tipos de
  /// item. Aqui o ativo é um modelo só, e cinco colunas custam menos
  /// que uma tabela 1-1 que todo `include` teria de lembrar.
  purchaseValue      Decimal?    @db.Decimal(12, 2)
  supplierId         String?     @db.Uuid
  invoiceNumber      String?
  /// Meses de amortização. Zero ou nulo é bem que não amortiza.
  amortizationMonths Int?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation("AtivoDoUsuario", fields: [userId], references: [id], onDelete: SetNull)
  supplier     Supplier?        @relation("FornecedorDoAtivo", fields: [supplierId], references: [id], onDelete: SetNull)
  manufacturer Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  assetModel   AssetModel?      @relation(fields: [assetModelId], references: [id], onDelete: SetNull)
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tickets      TicketAsset[]
  contracts    ContractAsset[]
  components   AssetComponent[]
  software     SoftwareInstallation[]
  licenses     LicenseAssignment[]
  consumables  ConsumableMovement[]

  /// Patrimônio e série não se repetem na organização: dois registros do
  /// mesmo equipamento são a origem de metade da sujeira de inventário.
  @@unique([organizationId, tag])
  @@unique([organizationId, serialNumber])
  @@index([organizationId, status])
  @@index([userId])
  @@index([locationId])
  @@map("assets")
}

/// Um chamado pode envolver mais de um equipamento, e um equipamento
/// acumula chamados — é o histórico que responde "essa máquina dá
/// problema?".
model TicketAsset {
  ticketId String   @db.Uuid
  assetId  String   @db.Uuid
  addedAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([ticketId, assetId])
  @@index([assetId])
  @@map("ticket_assets")
}

// ---------------------------------------------------------------------
// Satisfação
// ---------------------------------------------------------------------

/// Pesquisa de satisfação de um chamado. Substitui glpi_ticketsatisfactions.
///
/// Uma por chamado: mandar duas seria pedir a mesma nota duas vezes.
model Survey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  ticketId       String    @unique @db.Uuid
  /// O que abre a pesquisa sem exigir senha. Aleatório e único.
  token          String    @unique
  sentAt         DateTime?
  /// 1 a 5. Nulo enquanto não respondida.
  score          Int?
  comment        String?
  answeredAt     DateTime?
  /// Depois disto o link não abre mais.
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId, answeredAt])
  @@map("surveys")
}

// ---------------------------------------------------------------------
// Canais
// ---------------------------------------------------------------------

enum ChannelKind {
  EMAIL_IMAP
  EMAIL_SMTP
  EMAIL_WEBHOOK
  WHATSAPP_EVOLUTION
}

/// Configuração de uma caixa de e-mail ou de uma instância da Evolution.
model ChannelAccount {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  kind           ChannelKind
  name           String
  isActive       Boolean     @default(true)
  /// Configuração do canal. Segredos são cifrados na aplicação antes
  /// de entrar aqui — nunca em texto claro.
  config         Json
  /// Time que recebe os chamados abertos por este canal.
  defaultTeamId  String?     @db.Uuid
  lastSyncAt     DateTime?
  lastError      String?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inboundMessages InboundMessage[]

  @@unique([organizationId, name])
  @@map("channel_accounts")
}

/// Toda mensagem que entra por canal externo passa por aqui antes de
/// virar evento. A unicidade de externalId é o que impede chamado
/// duplicado quando dois polls concorrem — correção do GLPI, que não tem.
model InboundMessage {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  channelAccountId String    @db.Uuid
  channel          Channel
  /// Message-ID do e-mail ou id da mensagem na Evolution.
  externalId       String
  /// Message-ID referenciado em In-Reply-To / References.
  inReplyTo        String?
  fromAddress      String
  subject          String?
  bodyText         String?
  bodyHtml         String?
  rawHeaders       Json?
  /// Anexos já gravados no armazenamento na hora do recebimento.
  ///
  /// O binário chega junto com o webhook e está na memória; gravá-lo
  /// ali é mais barato que devolvê-lo ao provedor depois. A lista traz
  /// chave, nome, tipo e tamanho — o `AnexoRecebido` de shared.
  attachments      Json?
  receivedAt       DateTime  @default(now())
  /// Nulo até o processador transformar a mensagem em evento.
  eventId          String?   @unique @db.Uuid
  processedAt      DateTime?
  /// Preenchido quando a mensagem é descartada por regra ou erro.
  discardedReason  String?

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  event          TicketEvent?   @relation(fields: [eventId], references: [id])

  @@unique([organizationId, channel, externalId])
  @@index([processedAt])
  @@map("inbound_messages")
}

enum DeliveryStatus {
  PENDENTE
  ENVIADO
  FALHOU
}

/// Fila de saída: e-mail e WhatsApp. Substitui glpi_queuednotifications.
model OutboundMessage {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  channel        Channel
  ticketId       String?        @db.Uuid
  /// O evento que originou o envio. É o que permite olhar uma falha de
  /// entrega e saber qual resposta não chegou.
  eventId        String?        @db.Uuid
  toAddress      String
  subject        String?
  body           String
  /// Message-ID gerado, usado no threading da resposta.
  externalId     String?
  status         DeliveryStatus @default(PENDENTE)
  attempts       Int            @default(0)
  lastError      String?
  scheduledFor   DateTime       @default(now())
  sentAt         DateTime?
  createdAt      DateTime       @default(now())

  @@index([status, scheduledFor])
  @@index([organizationId, externalId])
  @@index([ticketId])
  @@map("outbound_messages")
}

/// Substitui RuleTicket / RuleMailCollector. Classificação na entrada.
model IntakeRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  /// Ordem de avaliação. Menor primeiro.
  position       Int
  isActive       Boolean @default(true)
  /// Ver IntakeRuleDefinition em packages/shared/src/domain.ts
  criteria       Json
  actions        Json
  /// Para de avaliar as regras seguintes quando esta casar.
  stopOnMatch    Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, position])
  @@map("intake_rules")
}

// ---------------------------------------------------------------------
// Integração de saída
// ---------------------------------------------------------------------

model OutboundWebhook {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  url            String
  /// Segredo do HMAC-SHA256 da assinatura. Cifrado na aplicação.
  secret         String
  /// Eventos assinados: ticket.criado, ticket.atualizado, ...
  events         String[]
  isActive       Boolean  @default(true)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@unique([organizationId, name])
  @@map("outbound_webhooks")
}

model WebhookDelivery {
  id           String         @id @default(uuid()) @db.Uuid
  webhookId    String         @db.Uuid
  event        String
  payload      Json
  status       DeliveryStatus @default(PENDENTE)
  attempts     Int            @default(0)
  /// Quando a próxima tentativa pode sair. É o backoff.
  scheduledFor DateTime       @default(now())
  responseCode Int?
  lastError    String?
  createdAt    DateTime       @default(now())
  deliveredAt  DateTime?

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("webhook_deliveries")
}

/// Chave de aplicação para o endpoint público de abertura de chamado.
model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  /// SHA-256 da chave. O valor cru é mostrado uma única vez, na criação.
  keyHash        String    @unique
  /// Permissões nomeadas concedidas a esta chave.
  scopes         String[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("api_keys")
}

/// Identidade visual da instalação.
///
/// É uma linha só (`id = 'unica'`): a marca precisa ser lida **antes**
/// do login, e antes do login não se sabe a organização. Marca por
/// organização, se um dia fizer sentido, entra como sobreposição
/// aplicada depois da autenticação — não como substituta desta.
model Brand {
  id                 String   @id @default("unica")
  /// O que aparece na aba do navegador e no cabeçalho.
  productName        String   @default("Norty Desk")
  /// Frase abaixo do nome, na tela de entrada.
  tagline            String?
  /// Chaves no armazenamento. Nulas significam usar a marca embutida.
  logoKey            String?
  logoContentType    String?
  faviconKey         String?
  faviconContentType String?
  /// Muda a cada upload. Entra na URL para o navegador não servir a
  /// logo antiga do cache depois da troca.
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt

  @@map("brand")
}

/// Trilha de auditoria de mudanças de configuração. Eventos de chamado
/// não entram aqui — a timeline já é a auditoria do chamado.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entity         String
  entityId       String?
  diff           Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/// Chamado recorrente — a manutenção preventiva em agenda.
///
/// Substitui `glpi_ticketrecurrents`. A diferença que importa está no
/// descritor de recorrência: o GLPI guarda periodicidade em segundos, o
/// que não consegue dizer "toda segunda e quinta" nem "todo dia 1º" sem
/// derrapar. Aqui o descritor mora em `schedule` (ver
/// `packages/shared`) e descreve o calendário, não o intervalo.
model RecurringTicket {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  isActive       Boolean @default(true)

  /// O molde do chamado que vai nascer.
  subject     String
  description String
  ticketType  TicketType @default(REQUISICAO)
  urgency     Int        @default(3)
  impact      Int        @default(3)

  categoryId     String? @db.Uuid
  assignedTeamId String? @db.Uuid
  /// Quem consta como requerente do chamado gerado. Chamado sem
  /// requerente não tem para quem responder.
  requesterId    String  @db.Uuid

  /// Descritor de recorrência. Union discriminada por `tipo`.
  schedule            Json
  timezone            String @default("America/Sao_Paulo")
  /// Quantos segundos antes da ocorrência o chamado é aberto: "a
  /// manutenção é dia 20, abra o chamado três dias antes".
  createBeforeSeconds Int    @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  /// A próxima ocorrência, já calculada. É por ela que o ciclo procura
  /// o que abrir, e é ela que a tela mostra sem recalcular nada.
  nextRunAt DateTime?
  lastRunAt DateTime?
  runCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])
  assignedTeam Team?        @relation("TimeDaRecorrencia", fields: [assignedTeamId], references: [id])
  requester    User         @relation("RequerenteDaRecorrencia", fields: [requesterId], references: [id])

  tickets Ticket[]

  @@unique([organizationId, name])
  @@index([isActive, nextRunAt])
  @@map("recurring_tickets")
}

enum TemplateKind {
  RESPOSTA
  SOLUCAO
  TAREFA
}

/// Modelo de texto pronto.
///
/// O GLPI tem tres tabelas quase identicas — `itilfollowuptemplates`,
/// `solutiontemplates`, `tasktemplates` —, cada uma com sua tela e seu
/// CRUD. Sao a mesma coisa usada em tres lugares. Aqui e um modelo com
/// discriminador: uma tela, uma busca, e o `kind` diz onde ele aparece.
model Template {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  kind           TemplateKind
  name           String
  body           String

  /// Quando presente, o modelo so e oferecido em chamado desta
  /// categoria — e o que evita a lista de sessenta modelos.
  categoryId String? @db.Uuid

  /// So para RESPOSTA: o texto entra como nota interna.
  isInternal Boolean @default(false)
  isActive   Boolean @default(true)

  /// Quantas vezes ja foi usado. Ordena a lista pelo que serve.
  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, isActive])
  @@map("templates")
}

enum ContractKind {
  SUPORTE
  LICENCA
  LOCACAO
  MANUTENCAO
  SERVICO
  OUTRO
}

/// Como o contrato é cobrado. Decide o custo mensal equivalente.
enum BillingPeriod {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  UNICO
}

/// Contrato com fornecedor.
///
/// Equivale a `glpi_contracts`. A diferença que importa é o aviso: lá a
/// antecedência (`notice`) existe como coluna e nada a lê — o contrato
/// vence e alguém descobre pela fatura. Aqui `noticeDays` alimenta a
/// consulta de vencimento e a tela.
model Contract {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  /// Número do contrato como o fornecedor o chama.
  number         String
  name           String
  kind           ContractKind @default(SERVICO)

  supplierId String? @db.Uuid

  startsAt   DateTime
  /// Fim da vigência. Nulo é contrato por prazo indeterminado.
  endsAt     DateTime?
  /// Com quantos dias de antecedência avisar do vencimento.
  noticeDays Int       @default(30)
  /// Renova sozinho se ninguém avisar. Muda o que o aviso significa.
  autoRenew  Boolean   @default(false)

  billingPeriod BillingPeriod @default(MENSAL)
  /// Valor de cada cobrança. Dinheiro é Decimal(12,2), nunca Float.
  value         Decimal       @default(0) @db.Decimal(12, 2)

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  assets   ContractAsset[]
  licenses SoftwareLicense[]

  @@unique([organizationId, number])
  @@index([organizationId, endsAt])
  @@map("contracts")
}

/// O que o contrato cobre. Substitui `glpi_contracts_items`, que no
/// GLPI é polimórfico sobre sessenta tipos de item.
model ContractAsset {
  contractId String   @db.Uuid
  assetId    String   @db.Uuid
  addedAt    DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([contractId, assetId])
  @@index([assetId])
  @@map("contract_assets")
}

/// Orçamento anual. Equivale a `glpi_budgets`.
model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  startsAt       DateTime
  endsAt         DateTime
  value          Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costs        TicketCost[]

  @@unique([organizationId, name])
  @@map("budgets")
}

enum CostKind {
  /// Horas de quem atendeu, pelo valor-hora do lançamento.
  TEMPO
  /// Peça, licença, deslocamento.
  MATERIAL
  /// Valor fechado, sem hora nem item.
  FIXO
}

/// Custo do chamado.
///
/// Equivale a `glpi_ticketcosts`, mas com um discriminador em vez de
/// três pares de colunas (`cost_time`, `cost_fixed`, `cost_material`)
/// que sempre vêm com duas zeradas. O total é a soma das linhas — não
/// há coluna de total no chamado, porque um total gravado diverge da
/// primeira linha corrigida.
model TicketCost {
  id       String   @id @default(uuid()) @db.Uuid
  ticketId String   @db.Uuid
  kind     CostKind @default(MATERIAL)
  label    String

  /// Só para TEMPO: quantidade de horas e valor da hora.
  hours      Decimal? @db.Decimal(8, 2)
  hourlyRate Decimal? @db.Decimal(12, 2)

  /// O valor da linha. Em TEMPO, é `hours * hourlyRate` calculado no
  /// lançamento — guardar o produto é o que preserva o histórico quando
  /// o valor-hora muda no ano seguinte.
  amount Decimal @db.Decimal(12, 2)

  budgetId String? @db.Uuid
  authorId String? @db.Uuid

  createdAt DateTime @default(now())

  ticket Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  budget Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  author User?   @relation("AutorDoCusto", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([budgetId])
  @@map("ticket_costs")
}

/// Localização em árvore. Substitui `glpi_locations`.
///
/// Mesma forma da categoria: pai, filhos e unicidade do nome dentro do
/// pai. Sem caminho denormalizado — a árvore de uma organização cabe
/// numa consulta, e um caminho gravado é mais uma coisa a atualizar
/// quando alguém renomeia o prédio.
model Location {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  parentId       String? @db.Uuid
  name           String
  /// Prédio, andar, sala: o que ajuda quem vai até lá.
  notes          String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Location?    @relation("Sublocalizacao", fields: [parentId], references: [id])
  children     Location[]   @relation("Sublocalizacao")

  assets      Asset[]
  consumables ConsumableItem[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@map("locations")
}

/// Fabricante. Substitui `glpi_manufacturers`.
model Manufacturer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  models       AssetModel[]
  assets       Asset[]
  components   AssetComponent[]
  software     Software[]
  consumables  ConsumableItem[]

  @@unique([organizationId, name])
  @@map("manufacturers")
}

/// Modelo de equipamento.
///
/// O GLPI tem uma tabela por tipo — `computermodels`, `monitormodels`,
/// `printermodels` e mais três —, todas com as mesmas quatro colunas.
/// Aqui é um modelo com discriminador, como o próprio ativo.
model AssetModel {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  manufacturerId String?   @db.Uuid
  kind           AssetKind @default(OUTRO)
  name           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  assets       Asset[]
  consumables  ConsumableItemModel[]

  @@unique([organizationId, manufacturerId, name])
  @@index([organizationId, kind])
  @@map("asset_models")
}

/// Uma peça dentro de um equipamento.
///
/// **Uma linha é uma peça.** Não há coluna de quantidade: dois pentes
/// de 8 GB são duas linhas, porque cada um tem o seu número de série e
/// o seu slot — e porque "16 GB" tem de sair de uma soma, não de uma
/// multiplicação que ninguém revisa.
///
/// Os atributos que mudam de um tipo para o outro moram em `attributes`,
/// validados por `validarAtributos` contra a ficha que
/// `ATRIBUTOS_DO_COMPONENTE` declara em `packages/shared`. É a mesma
/// função que valida o formulário dinâmico: um formulário é um
/// formulário. A diferença é que esta ficha não se edita pela tela.
model AssetComponent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  assetId        String        @db.Uuid
  kind           ComponentKind
  /// Modelo da peça: "Kingston KVR26N19S8", "Samsung 980".
  name           String
  manufacturerId String?       @db.Uuid
  serialNumber   String?
  /// A ficha do tipo. `{}` quando o tipo não tem atributo nenhum.
  attributes     Json          @default("{}")
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  /// Série de peça não se repete na organização — quando existe. Duas
  /// linhas com a mesma série são a mesma peça contada duas vezes, e é
  /// assim que a memória da frota dobra sozinha.
  @@unique([organizationId, serialNumber])
  @@index([assetId, kind])
  @@map("asset_components")
}

// ---------------------------------------------------------------------
// Fontes de autenticação (docs/13)
// ---------------------------------------------------------------------

enum AuthSourceKind {
  LDAP
}

enum LdapSecurity {
  NONE
  STARTTLS
  LDAPS
}

/// Diretório que autentica as pessoas de uma organização — o equivalente
/// a `glpi_authldaps`, mas por organização, porque cada cliente traz o
/// próprio AD.
model AuthSource {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  name            String
  kind            AuthSourceKind @default(LDAP)
  isActive        Boolean        @default(true)
  /// Ordem de tentativa quando a organização tem mais de um diretório.
  position        Int            @default(0)
  host            String
  port            Int            @default(389)
  security        LdapSecurity   @default(STARTTLS)
  baseDn          String
  /// Conta de serviço que faz as buscas. Vazia = bind anônimo.
  bindDn          String?
  /// Cifrada com CHANNEL_SECRET_KEY (channels/segredos.ts). Nunca sai da API.
  bindPassword    String?
  loginField      String         @default("sAMAccountName")
  syncField       String         @default("objectGUID")
  /// Filtro extra, combinado com o do login num `(& ...)`.
  userFilter      String?
  emailField      String         @default("mail")
  nameField       String         @default("displayName")
  phoneField      String?        @default("telephoneNumber")
  timeoutMs       Int            @default(5000)
  /// Cria a pessoa no primeiro login bem-sucedido (decisão do Yuri).
  autoCreate      Boolean        @default(true)
  defaultRole     Role           @default(SOLICITANTE)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("auth_sources")
}

// =========================================================
//  Software e licenças — Fase 6 (docs/10-roadmap.md)
// ---------------------------------------------------------
//  O GLPI separa Software, SoftwareVersion, Item_SoftwareVersion,
//  SoftwareLicense e Item_SoftwareLicense. Aqui são os mesmos cinco
//  conceitos, porque cada um responde uma pergunta diferente:
//  o que existe, em que versão, onde está instalado, o que foi
//  comprado, e quem ocupa cada assento.
// =========================================================

enum LicenseKind {
  PERPETUA
  ASSINATURA
  OEM
  VOLUME
  GRATUITA
}

model Software {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  /// Editora, do mesmo catálogo de fabricantes dos ativos.
  manufacturerId String?  @db.Uuid
  /// Texto curto para agrupar: "Escritório", "Segurança", "Sistema".
  category       String?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer?     @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  versions     SoftwareVersion[]
  licenses     SoftwareLicense[]

  @@unique([organizationId, manufacturerId, name])
  @@index([organizationId, name])
  @@map("software")
}

model SoftwareVersion {
  id         String   @id @default(uuid()) @db.Uuid
  softwareId String   @db.Uuid
  /// "2021", "24.1.3", "Home". Texto: versão não é número.
  name       String
  createdAt  DateTime @default(now())

  software      Software               @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  installations SoftwareInstallation[]
  licenses      SoftwareLicense[]

  @@unique([softwareId, name])
  @@map("software_versions")
}

/// Uma versão instalada num equipamento — o `Item_SoftwareVersion` do GLPI.
model SoftwareInstallation {
  id          String    @id @default(uuid()) @db.Uuid
  assetId     String    @db.Uuid
  versionId   String    @db.Uuid
  installedAt DateTime?
  createdAt   DateTime  @default(now())

  asset   Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version SoftwareVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([assetId, versionId])
  @@index([versionId])
  @@map("software_installations")
}

/// O que foi comprado: um lote de assentos de um software.
model SoftwareLicense {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  softwareId     String      @db.Uuid
  /// Versão coberta. Nula = qualquer versão do software.
  versionId      String?     @db.Uuid
  name           String
  kind           LicenseKind @default(PERPETUA)
  /// Chave/serial, cifrada com CHANNEL_SECRET_KEY (channels/segredos.ts).
  /// Só quem gerencia ativos a vê.
  licenseKey     String?
  /// Quantos assentos foram comprados. Nulo = ilimitada (site, gratuita).
  seats          Int?
  purchasedAt    DateTime?
  /// Fim da validade. Nulo = não vence (perpétua).
  expiresAt      DateTime?
  purchaseValue  Decimal?    @db.Decimal(12, 2)
  supplierId     String?     @db.Uuid
  contractId     String?     @db.Uuid
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  software     Software            @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  version      SoftwareVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  supplier     Supplier?           @relation("FornecedorDaLicenca", fields: [supplierId], references: [id], onDelete: SetNull)
  contract     Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  assignments  LicenseAssignment[]

  @@index([organizationId, expiresAt])
  @@index([softwareId])
  @@map("software_licenses")
}

/// Um assento ocupado: por um equipamento OU por uma pessoa (CHECK no banco).
model LicenseAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  String   @db.Uuid
  assetId    String?  @db.Uuid
  userId     String?  @db.Uuid
  assignedAt DateTime @default(now())

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  asset   Asset?          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([licenseId, assetId])
  @@unique([licenseId, userId])
  @@index([assetId])
  @@index([userId])
  @@map("license_assignments")
}

// =========================================================
//  Consumíveis e cartuchos — Fase 6 (docs/10-roadmap.md)
// ---------------------------------------------------------
//  O GLPI guarda uma linha por unidade. Aqui o estoque é a soma
//  das movimentações: responde "quanto tem", "para quem foi" e
//  "quantos toners esta impressora comeu" sem mil linhas para
//  cem caixas de papel.
// =========================================================

enum ConsumableKind {
  CONSUMIVEL
  TONER
}

enum MovementKind {
  ENTRADA
  SAIDA
  AJUSTE
}

model ConsumableItem {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  kind           ConsumableKind @default(CONSUMIVEL)
  name           String
  /// Código do fabricante (ex.: CF258A). É por ele que se compra.
  reference      String?
  manufacturerId String?        @db.Uuid
  /// Onde fica o estoque.
  locationId     String?        @db.Uuid
  /// No mínimo ou abaixo, a lista avisa que é hora de comprar.
  minStock       Int            @default(0)
  unit           String         @default("un")
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manufacturer     Manufacturer?         @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  location         Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  compatibleModels ConsumableItemModel[]
  movements        ConsumableMovement[]

  @@unique([organizationId, name])
  @@index([organizationId, kind])
  @@map("consumable_items")
}

/// Modelo de equipamento que usa o consumível — como a impressora sabe qual toner leva.
model ConsumableItemModel {
  itemId       String @db.Uuid
  assetModelId String @db.Uuid

  item       ConsumableItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assetModel AssetModel     @relation(fields: [assetModelId], references: [id], onDelete: Cascade)

  @@id([itemId, assetModelId])
  @@index([assetModelId])
  @@map("consumable_item_models")
}

model ConsumableMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  itemId         String       @db.Uuid
  kind           MovementKind
  /// Positiva em entrada e saída; com sinal no ajuste (CHECK no banco).
  quantity       Int
  /// Para onde foi (só na saída): um equipamento ou uma pessoa.
  assetId        String?      @db.Uuid
  userId         String?      @db.Uuid
  /// Quem registrou.
  authorId       String?      @db.Uuid
  note           String?
  createdAt      DateTime     @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         ConsumableItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset        Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  user         User?          @relation("DestinatarioDoConsumivel", fields: [userId], references: [id], onDelete: SetNull)
  author       User?          @relation("AutorDoMovimento", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([assetId])
  @@index([organizationId])
  @@map("consumable_movements")
}

