# --- Banco: CT 102 Yggdrasil ---
DATABASE_URL="postgresql://nortydesk:TROQUE@192.168.15.72:5432/nortydesk?schema=public"

# --- Aplicação ---
NODE_ENV=production
PORT=3061
# A API não publica porta no CT: só o nginx do desk-web a alcança.
API_PREFIX=v1
WEB_ORIGIN=https://chamados.norty.com.br

# --- Autenticação ---
# openssl rand -hex 48
JWT_SECRET=TROQUE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Chave de cifragem dos segredos de canal (AES-256-GCM). openssl rand -hex 32
CHANNEL_SECRET_KEY=TROQUE

# --- Redis: CT 102 (estado de conversa do WhatsApp, filas) ---
REDIS_URL=redis://192.168.15.72:6379

# --- MinIO: CT 102 ---
MINIO_ENDPOINT=192.168.15.72
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=TROQUE
MINIO_SECRET_KEY=TROQUE
MINIO_BUCKET=norty-desk

# --- Evolution API: CT 102 ---
EVOLUTION_BASE_URL=http://192.168.15.72:8080
EVOLUTION_INSTANCE=norty-desk
EVOLUTION_API_KEY=TROQUE

# --- E-mail de saída ---
SMTP_HOST=smtp.norty.com.br
SMTP_PORT=587
SMTP_USER=suporte@norty.com.br
SMTP_PASSWORD=TROQUE
SMTP_FROM="Norty Desk <suporte@norty.com.br>"

# --- Ollama: CT 102 (transcrição de áudio do WhatsApp) ---
# Em branco desliga a transcrição: o áudio segue como anexo, e é só.
# O modelo roda na rede da casa — áudio de cliente não sai para
# serviço de terceiro.
OLLAMA_BASE_URL=http://192.168.15.72:11434
OLLAMA_MODELO_AUDIO=whisper
TRANSCRICAO_LIMITE_MB=25

# --- Webhooks de saída ---
# Entregas terminadas são podadas depois deste prazo. As pendentes,
# nunca: entrega que ainda não saiu não é lixo.
WEBHOOK_RETENCAO_DIAS=30
