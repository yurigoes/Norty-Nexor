{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "declaration": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
