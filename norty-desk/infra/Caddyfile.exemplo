# Bloco do Norty Desk para o Caddy do CT 105 Asgard.
# Ver docs/11-infra.md, seção 4.

desk.norty.com.br {
    encode gzip zstd

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy desk-api:3061
    }

    handle {
        reverse_proxy desk-web:3060
    }
}

# Endereço público para integração e webhook (e-mail, Evolution).
api-desk.norty.com.br {
    encode gzip zstd
    reverse_proxy desk-api:3061
}
