{
  "name": "@nexor/licitacoes-shared",
  "version": "0.1.0",
  "private": true,
  "description": "Domínio de licitações públicas: tabelas do PNCP, perfil de fornecedor e motor de triagem",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/stamp-module-type.mjs",
    "dev": "tsc -p tsconfig.esm.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.esm.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "@types/node": "^24.13.3"
  }
}
