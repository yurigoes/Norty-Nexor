# Desenvolvimento local da API do Norty Car.
# Banco: crie um papel SEM superusuário e SEM BYPASSRLS (o RLS precisa valer para ele):
#   CREATE ROLE nortycar LOGIN PASSWORD '...' CREATEDB NOSUPERUSER NOBYPASSRLS;
#   CREATE DATABASE nortycar_dev OWNER nortycar;
DATABASE_URL=postgresql://nortycar:SENHA@127.0.0.1:5432/nortycar_dev?schema=public
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
SECRETS_KEY=
PORT=3334
CORS_ORIGINS=http://localhost:5174
APP_URL=http://localhost:5174
STORAGE_DIR=./storage
JOBS_ENABLED=true
# Opcionais
SMTP_HOST=
SMTP_FROM=
ANTHROPIC_API_KEY=

# Modo apresentação: e-mails que podem trocar o próprio perfil pelo menu do usuário.
# Deixe vazio em produção real.
DEMO_ROLE_SWITCH_EMAILS=
