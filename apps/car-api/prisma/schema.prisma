model InspectionTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  /// [{ key, label, area }]
  items          Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("inspection_templates")
}

enum InspectionType {
  DELIVERY
  PERIODIC
  DRIVER_CHANGE
  RETURN
}

enum InspectionStatus {
  DRAFT
  COMPLETED
  APPROVED
}

enum ConfirmationType {
  SIGNATURE_DRAWN
  ACKNOWLEDGED_IN_PERSON
}

/// Vistoria. Ao concluir, itens, avarias e fotos ficam imutáveis
/// (gatilho): a evidência não pode ser trocada depois.
model Inspection {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  branchId         String            @db.Uuid
  number           String
  type             InspectionType
  status           InspectionStatus  @default(DRAFT)
  vehicleUnitId    String            @db.Uuid
  contractId       String?           @db.Uuid
  driverId         String?           @db.Uuid
  inspectorId      String            @db.Uuid
  odometerKm       Int?
  /// Nível de combustível em oitavos (0 a 8).
  fuelEighths      Int?
  notes            String?
  pendencies       String?
  confirmationType ConfirmationType?
  signerName       String?
  signatureFileId  String?           @db.Uuid
  visibleToCustomer Boolean          @default(false)
  startedAt        DateTime          @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?         @db.Timestamptz(3)
  approvedById     String?           @db.Uuid
  approvedAt       DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id])
  vehicle      VehicleUnit        @relation(fields: [vehicleUnitId], references: [id])
  contract     RentalContract?    @relation(fields: [contractId], references: [id])
  items        InspectionItem[]
  damages      InspectionDamage[]
  photos       InspectionPhoto[]

  @@unique([organizationId, number])
  @@index([vehicleUnitId, startedAt])
  @@map("inspections")
}

enum InspectionItemStatus {
  OK
  DAMAGED
  MISSING
  NA
}

model InspectionItem {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  inspectionId   String               @db.Uuid
  key            String
  label          String
  area           String
  status         InspectionItemStatus @default(OK)
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id])
  inspection   Inspection   @relation(fields: [inspectionId], references: [id])

  @@unique([inspectionId, key])
  @@map("inspection_items")
}

model InspectionDamage {
  id             String   @id @default(uuid()) @db.Uuid
