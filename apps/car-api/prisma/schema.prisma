  vehicleUnitId    String         @db.Uuid
  driverId         String?        @db.Uuid
  contractId       String?        @db.Uuid
  at               DateTime       @db.Timestamptz(3)
  station          String?
  fuel             FuelType
  liters           Decimal        @db.Decimal(10, 3)
  pricePerLiter    Decimal        @db.Decimal(10, 3)
  total            Decimal        @db.Decimal(12, 2)
  odometerKm       Int
  paymentMethod    PaymentMethod?
  paidByCompany    Boolean        @default(true)
  receiptFileId    String?        @db.Uuid
  notes            String?
  flags            String[]       @default([])
  consumptionKmL   Decimal?       @db.Decimal(8, 2)
  createdById      String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      VehicleUnit  @relation(fields: [vehicleUnitId], references: [id])
  driver       Driver?      @relation(fields: [driverId], references: [id])

  @@index([vehicleUnitId, at])
  @@map("refuel_records")
}

enum SaleStatus {
  LISTED
  NEGOTIATING
  SOLD
  WITHDRAWN
}

model VehicleSale {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @db.Uuid
  vehicleUnitId    String     @db.Uuid
  status           SaleStatus @default(LISTED)
  appraisalValue   Decimal?   @db.Decimal(12, 2)
  askingPrice      Decimal    @db.Decimal(12, 2)
  minimumPrice     Decimal?   @db.Decimal(12, 2)
  listedAt         DateTime   @default(now()) @db.Timestamptz(3)
  adChannels       String[]   @default([])
  soldAt           DateTime?  @db.Timestamptz(3)
  salePrice        Decimal?   @db.Decimal(12, 2)
  buyerName        String?
  buyerDocument    String?
  receivableId     String?    @db.Uuid
  bookValueAtSale  Decimal?   @db.Decimal(12, 2)
  notes            String?
  createdById      String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id])
  vehicle      VehicleUnit    @relation(fields: [vehicleUnitId], references: [id])
  proposals    SaleProposal[]

  @@index([organizationId, status])
  @@map("vehicle_sales")
}

enum ProposalStatus {
  OPEN
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model SaleProposal {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  saleId         String         @db.Uuid
  name           String
  contact        String?
  amount         Decimal        @db.Decimal(12, 2)
  status         ProposalStatus @default(OPEN)
  notes          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  sale         VehicleSale  @relation(fields: [saleId], references: [id])

  @@map("sale_proposals")
}

// =========================================================
//  SITE PÚBLICO E PORTAL DO CLIENTE
// =========================================================

model SiteConfig {
  organizationId   String   @id @db.Uuid
  published        Boolean  @default(false)
  brandName        String
  logoFileId       String?  @db.Uuid
  bannerFileId     String?  @db.Uuid
  primaryColor     String   @default("#1677FF")
  accentColor      String   @default("#20C5A0")
  heroTitle        String?
  heroSubtitle     String?
  about            String?
  faq              Json     @default("[]")
  terms            String?
  privacy          String?
  whatsapp         String?
  phone            String?
  email            String?
  citiesServed     String[] @default([])
  featuredModelIds String[] @default([])
  seoTitle         String?
  seoDescription   String?
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("site_configs")
}

enum LeadKind {
  QUOTE
  CONTACT
  MONTHLY
  RESERVATION_REQUEST
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  DISCARDED
}

/// Pedido vindo do site. Nunca é uma reserva confirmada: alguém da
/// locadora analisa, confere disponibilidade e confirma.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  branchId       String?    @db.Uuid
  kind           LeadKind
  status         LeadStatus @default(NEW)
  name           String
  email          String?
  phone          String?
  message        String?
  categoryId     String?    @db.Uuid
  modelId        String?    @db.Uuid
  startAt        DateTime?  @db.Timestamptz(3)
  endAt          DateTime?  @db.Timestamptz(3)
  quote          Json?
  consent        Boolean    @default(false)
  reservationId  String?    @db.Uuid
  handledById    String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("leads")
}

enum ServiceRequestType {
  MAINTENANCE
  ASSISTANCE
  VEHICLE_SWAP
  RENEWAL
  TERMINATION
  DATA_CORRECTION
  DATA_ACCESS
  OTHER
}

enum ServiceRequestStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

model ServiceRequest {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  customerId     String               @db.Uuid
  contractId     String?              @db.Uuid
  type           ServiceRequestType
  subject        String
  description    String
  status         ServiceRequestStatus @default(OPEN)
  createdByUserId String?             @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id])
  customer     Customer                @relation(fields: [customerId], references: [id])
  messages     ServiceRequestMessage[]

  @@index([organizationId, status])
  @@map("service_requests")
}

model ServiceRequestMessage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  requestId      String   @db.Uuid
  authorUserId   String?  @db.Uuid
  fromCustomer   Boolean
  body           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id])
  request      ServiceRequest @relation(fields: [requestId], references: [id])

  @@map("service_request_messages")
}

// =========================================================
//  NOTIFICAÇÕES, AUDITORIA E INTEGRAÇÕES
// =========================================================

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

/// Notificação para a equipe com uma permissão (`audiencePermission`) ou
/// para um usuário específico. `dedupeKey` único por empresa: o mesmo
/// alerta (ex.: CNH do motorista X vencendo em 30 dias) nasce uma vez.
model Notification {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  branchId           String?              @db.Uuid
  userId             String?              @db.Uuid
  customerId         String?              @db.Uuid
  audiencePermission String?
  type               String
  severity           NotificationSeverity @default(INFO)
  title              String
  body               String
  link               String?
  dedupeKey          String
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id])
  reads        NotificationRead[]
  deliveries   NotificationDelivery[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model NotificationRead {
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  readAt         DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_reads")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  WEBHOOK
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NOT_CONFIGURED
}

/// Fila de envio por canal externo. Tentativas controladas com backoff.
model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  notificationId String              @db.Uuid
  channel        NotificationChannel
  target         String
  status         DeliveryStatus      @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now()) @db.Timestamptz(3)
  lastError      String?
  sentAt         DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, target])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

enum ActorType {
  USER
  PLATFORM
  SUPPORT
  CUSTOMER
  SYSTEM
  INTEGRATION
  PUBLIC
}

/// Trilha de auditoria. Só aceita INSERT (gatilho). `organizationId`
/// nulo = ação de plataforma, visível só ao Master.
model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  at             DateTime  @default(now()) @db.Timestamptz(3)
  organizationId String?   @db.Uuid
  branchId       String?   @db.Uuid
  actorType      ActorType
  actorUserId    String?   @db.Uuid
  actorName      String?
  supportGrantId String?   @db.Uuid
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  reason         String?
  ip             String?
  userAgent      String?
  requestId      String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, at])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  VERIFIED
  ERROR
}

/// Configuração de integração. `organizationId` nulo = global da Norty.
/// Segredos ficam cifrados (`secretEnc`) e nunca voltam para o cliente.
model IntegrationConfig {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @db.Uuid
  provider       String
  status         IntegrationStatus @default(NOT_CONFIGURED)
  config         Json              @default("{}")
  secretEnc      String?
  lastTestAt     DateTime?         @db.Timestamptz(3)
  lastTestResult String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@map("integration_configs")
}

/// Chave de API para integração de sistemas. Só o hash é guardado.
model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  prefix         String    @unique
  keyHash        String
  scopes         String[]
  lastUsedAt     DateTime? @db.Timestamptz(3)
  expiresAt      DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("api_keys")
}

/// Webhook de saída: a empresa recebe eventos assinados com HMAC.
model WebhookEndpoint {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  url            String
  events         String[]
  secretEnc      String
  active         Boolean   @default(true)
  lastStatus     Int?
  lastDeliveryAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("webhook_endpoints")
}
