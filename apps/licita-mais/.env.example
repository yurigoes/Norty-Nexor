# =========================================================
#  LICITA+ — variáveis de produção
# ---------------------------------------------------------
#  Copie para `.env` NO HOST, ao lado do docker-compose.yml, em
#  /srv/apps-fase1/licita-mais/.env — e não no repositório.
#  O deploy preserva esse arquivo justamente por isso.
#
#    cp .env.example .env && chmod 600 .env
# =========================================================

# ---------- Obrigatórias ----------

# Postgres da Norty (CT 102). O banco precisa existir antes:
#   CREATE DATABASE licita;
#   CREATE USER licita WITH PASSWORD '...';
#   GRANT ALL PRIVILEGES ON DATABASE licita TO licita;
DATABASE_URL=postgresql://licita:TROQUE@192.168.15.72:5432/licita?schema=public

# Assina o access token. Gere com:
#   openssl rand -base64 48
# Trocar este valor derruba todas as sessões abertas — o que é
# exatamente o que se quer se ele vazar.
JWT_SECRET=

# ---------- Domínio ----------

APP_URL=https://licita.norty.com.br
CORS_ORIGINS=https://licita.norty.com.br

# Vazio prende o cookie ao host que o emitiu — o mais restrito.
COOKIE_DOMAIN=

# ---------- Sessão ----------

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------- E-mail (SMTP do heimdall) ----------
#  Sem SMTP_HOST a API sobe e o cadastro funciona, mas o link de
#  confirmação nunca chega — e sem confirmar ninguém entra. Este
#  é o bloco que separa "no ar" de "utilizável".
#
#  A 465 é TLS implícito e a API já assume `seguro` por causa dela;
#  SMTP_SECURE só existe para o caso de um servidor fugir da
#  convenção. Se um dia trocar para 587 (STARTTLS), o modo muda
#  junto, sozinho.

#  O endereço em SMTP_FROM precisa ser o MESMO de SMTP_USER.
#  Autenticar como um e enviar como outro faz o relay recusar com
#  "not allowed to send from this address" — e a conta fica sem
#  poder confirmar o e-mail.

SMTP_HOST=mail.norty.com.br
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LICITA+ <preencha-com-o-mesmo-de-SMTP_USER>

# ---------- Ingestão do PNCP ----------
#  Estados varridos na rotina diária das 5h. Cada estado a mais
#  multiplica o tempo da varredura — comece pela sua região.

PNCP_UFS=BA,SE,PE
PNCP_JANELA_DIAS=30

#  O PNCP corta com 429 quem pede rápido demais, e uma varredura de
#  três estados são dezenas de páginas. Este é o intervalo mínimo
#  entre pedidos, em ms — o ponto de partida, não um teto: a cada
#  429 o cliente afrouxa sozinho e avisa no log qual passo aguentou.
#  Só mexa aqui se o aviso aparecer em toda varredura.

PNCP_INTERVALO_MS=900

# ---------- Porta no CT ----------
#  Só o front publica porta; a API fica na rede interna.

LICITA_PORT=3500
